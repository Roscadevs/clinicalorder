# Variables de entorno para docker-compose.
# Copiá este archivo a ".env" (en la raiz) y completá con valores reales.
# El archivo ".env" esta en .gitignore y NO debe subirse al repositorio.

# --- Base de datos PostgreSQL (contenedor local) ---
POSTGRES_PASSWORD=cambiar_por_una_password_segura

# --- Seguridad JWT (generar aleatoria, p. ej. openssl rand -base64 48) ---
JWT_SECRET_KEY=cambiar_por_una_clave_larga_y_aleatoria

# --- MercadoPago Checkout Pro (credenciales de TEST desde el panel de MercadoPago) ---
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=tu_webhook_secret

# --- Google Gemini ---
GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Supabase ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_STORAGE_URL=https://tu-proyecto.supabase.co/storage/v1
SUPABASE_ANON_KEY=tu_supabase_anon_key


AES_ENCRYPTION_KEY=clave_base64_de_32_bytes