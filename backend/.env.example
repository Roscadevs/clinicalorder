# Base de Datos PostgreSQL en Supabase
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.your_supabase_project_ref
DB_PASSWORD=your_secure_supabase_db_password

# Seguridad JWT
JWT_SECRET=9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b
JWT_EXPIRATION_MS=28800000

# Cifrado AES-256-GCM para contenido clínico sensible (historias clínicas, entradas clínicas)
# Generar con: openssl rand -base64 32
# NUNCA commitear la clave real — solo este placeholder debe estar en el repositorio.
AES_ENCRYPTION_KEY=<replace-with-32-byte-base64-encoded-key>

# Pasarela MercadoPago Checkout Pro
MERCADOPAGO_ACCESS_TOKEN=APP_USR-1234567890-abcdef
MERCADOPAGO_WEBHOOK_SECRET=your_mp_webhook_secret_key

# Inteligencia Artificial Google Gemini API
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere123456

# Almacenamiento Supabase Storage
SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1
SUPABASE_STORAGE_KEY=your_supabase_anon_public_key
SUPABASE_BUCKET_NAME=photos
