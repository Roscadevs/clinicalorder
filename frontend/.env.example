# URL Base de la API REST del Backend Spring Boot
VITE_API_BASE_URL=http://localhost:8080/api/v1

# En producción desplegado en Vercel, apuntar al dominio público del Backend:
# VITE_API_BASE_URL=https://clinica-backend.onrender.com/api/v1

# Supabase (Project Settings -> API en el panel de Supabase)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key

# WhatsApp de la clínica para solicitar turnos (formato internacional, sólo dígitos)
VITE_WHATSAPP_NUMBER=

# Dirección del consultorio (aparece en comprobantes y recordatorios)
VITE_CLINIC_ADDRESS=
