        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    USER ||--o{ APPOINTMENT : creates\n    USER ||--o{ CLINICAL_NOTE : authors\n    USER ||--o{ MEDICAL_RECORD : creates\n    USER ||--o{ CALENDAR_BLOCK : creates\n    USER ||--o{ PAYMENT_TRANSACTION : records\n    USER ||--o{ PASSWORD_RESET_TOKEN : requests\n\n    PATIENT ||--o{ APPOINTMENT : has\n    PATIENT ||--o{ CLINICAL_NOTE : has\n    PATIENT ||--|| MEDICAL_RECORD : has\n\n    DERMATOLOGIC_SERVICE ||--o{ APPOINTMENT : offered_in\n\n    APPOINTMENT ||--o{ PAYMENT_TRANSACTION : has\n    APPOINTMENT ||--o{ CLINICAL_NOTE : has\n    APPOINTMENT |o--o| APPOINTMENT : follow_up_of\n\n    CLINICAL_NOTE ||--o{ CLINICAL_NOTE_AUDIT : has\n\n    MEDICAL_RECORD ||--o{ MEDICAL_RECORD_AUDIT : has\n    MEDICAL_RECORD ||--o{ MEDICAL_PHOTO : has\n\n    USER {\n        bigint id PK\n        varchar username UK\n        varchar password_hash\n        varchar email UK\n        varchar full_name\n        user_role role\n        boolean active\n        int failed_login_attempts\n        timestamp locked_until\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    PATIENT {\n        bigint id PK\n        varchar name\n        varchar dni UK\n        varchar phone UK\n        varchar email UK\n        date birth_date\n        varchar profession\n        boolean active\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    DERMATOLOGIC_SERVICE {\n        bigint id PK\n        varchar name\n        varchar description\n        int duration_minutes\n        decimal base_price\n        int deposit_percentage\n        int follow_up_interval_days\n        boolean active\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    APPOINTMENT {\n        bigint id PK\n        bigint patient_id FK\n        bigint service_id FK\n        bigint created_by_user_id FK\n        timestamp start_time\n        timestamp end_time\n        appointment_status status\n        decimal agreed_price\n        bigint follow_up_of FK, UK\n        timestamp slot_reserved_until\n        int reschedule_count\n        timestamp original_start_time\n        int version\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    PAYMENT_TRANSACTION {\n        bigint id PK\n        bigint appointment_id FK\n        varchar mp_preference_id\n        varchar mp_payment_id UK\n        payment_type_enum payment_type\n        decimal amount\n        payment_status_enum status\n        bigint recorded_by_user_id FK\n        timestamp payment_date\n        timestamp created_at\n    }\n\n    CALENDAR_BLOCK {\n        bigint id PK\n        bigint created_by_user_id FK\n        timestamp start_time\n        timestamp end_time\n        varchar reason\n        timestamp created_at\n    }\n\n    CLINICAL_NOTE {\n        bigint id PK\n        bigint patient_id FK\n        bigint appointment_id FK\n        bigint author_user_id FK\n        bytea content\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    CLINICAL_NOTE_AUDIT {\n        bigint id PK\n        bigint clinical_note_id FK\n        bigint modified_by_user_id FK\n        bytea previous_content\n        bytea new_content\n        timestamp modified_at\n    }\n\n    MEDICAL_RECORD {\n        bigint id PK\n        bigint patient_id FK, UK\n        bigint created_by_user_id FK\n        boolean has_hta\n        boolean has_dbt\n        boolean has_hypothyroidism\n        boolean has_hyperthyroidism\n        boolean has_anemia\n        boolean has_autoimmune_diseases\n        boolean has_glaucoma\n        boolean has_coagulation_disorders\n        boolean has_scarring_alterations\n        varchar other_pathological\n        boolean allergy_anesthesia\n        boolean allergy_egg\n        boolean allergy_fish\n        varchar other_allergies\n        boolean habit_tobacco\n        boolean habit_alcohol\n        boolean habit_sun_exposure\n        boolean habit_spf_use\n        varchar surgical_history\n        varchar gynecological_history\n        varchar current_medications\n        varchar previous_aesthetic_treatments\n        int fitzpatrick_phototype\n        bytea physical_examination\n        bytea treatment_plan\n        boolean informed_consent_signed\n        timestamp created_at\n        timestamp updated_at\n    }\n\n    MEDICAL_RECORD_AUDIT {\n        bigint id PK\n        bigint medical_record_id FK\n        bigint modified_by_user_id FK\n        varchar modified_section\n        jsonb previous_values\n        jsonb new_values\n        timestamp modified_at\n    }\n\n    MEDICAL_PHOTO {\n        bigint id PK\n        bigint medical_record_id FK\n        varchar file_path\n        varchar original_filename\n        varchar content_type\n        bigint file_size\n        varchar description\n        timestamp uploaded_at\n    }\n\n    PASSWORD_RESET_TOKEN {\n        bigint id PK\n        bigint user_id FK\n        varchar token UK\n        boolean used\n        timestamp expires_at\n        timestamp created_at\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2nRXYZ_FQG69RAHA2MNe-952">
